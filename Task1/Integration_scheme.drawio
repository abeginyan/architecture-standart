<mxCell id="c9" value="Сотрудник отдела кредитования" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073b6f;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1400" y="70" width="250" height="64" as="geometry"/></mxCell>
