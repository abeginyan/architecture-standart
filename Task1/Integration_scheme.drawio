<mxCell id="c11" value="&lt;b&gt;Интернет-банк&lt;/b&gt;&lt;br&gt;ASP.NET MVC / .NET Fw 4.5, MS SQL&lt;br&gt;монолит, платформа подрядчика;&lt;br&gt;платежи и открытие тек. счетов" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="200" width="210" height="100" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;Система кол-центра&lt;/b&gt;&lt;br&gt;React / Java Spring Boot / PostgreSQL&lt;br&gt;микросервисы, платформа подрядчика" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="620" width="210" height="100" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;Система партнёрского кол-центра&lt;/b&gt;&lt;br&gt;(внешняя информационная система)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="760" width="210" height="80" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;Delphi-клиент + Oracle (логика на PL/SQL)&lt;br&gt;учёт операций, бухгалтерия,&lt;br&gt;депозиты и кредиты (разные разделы)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="300" height="200" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;Эл. почта + Excel-файл расчёта ставок&lt;/b&gt;&lt;br&gt;(ручной обмен, ставки нигде больше не ведутся)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="230" height="80" as="geometry"/></mxCell>
