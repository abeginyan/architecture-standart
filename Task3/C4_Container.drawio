<mxCell id="c7" value="C4. Диаграмма контейнеров: открытие депозитов онлайн (MVP)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=15;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1800" height="28" as="geometry"/></mxCell>
