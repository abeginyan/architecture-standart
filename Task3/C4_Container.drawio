<mxCell id="c9" value="&lt;b&gt;Менеджер кол-центра&lt;/b&gt;&lt;br&gt;[Person]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073b6f;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1330" y="50" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Менеджер бэк-офиса депозитов&lt;/b&gt;&lt;br&gt;[Person]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073b6f;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1560" y="850" width="210" height="80" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;Сотрудник кредитования&lt;/b&gt;&lt;br&gt;[Person]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073b6f;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1790" y="850" width="210" height="80" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;Frontend сайта&lt;/b&gt;&lt;br&gt;[PHP + React.js]&lt;br&gt;новое: список депозитов, форма заявки" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2e6295;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="285" y="65" width="290" height="85" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;Система кол-центра&lt;/b&gt;&lt;br&gt;[React / Java Spring Boot / PostgreSQL]&lt;br&gt;новое: приём заявок с сайта" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2e6295;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="955" y="62" width="300" height="88" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;Монолит интернет-банка&lt;/b&gt;&lt;br&gt;[ASP.NET MVC, .NET Fw 4.5]&lt;br&gt;новое: страницы депозитов и заявки; сессия клиента, список счетов" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2e6295;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="285" y="250" width="245" height="120" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;БД интернет-банка&lt;/b&gt;&lt;br&gt;[MS SQL]" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#666666;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="285" y="420" width="245" height="90" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;[YARP / nginx]&lt;br&gt;TLS, проверка токена, балансировка, ограничение частоты запросов" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2d9c5a;strokeColor=#1f7a45;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="215" height="110" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;b&gt;Сервис депозитов&lt;/b&gt;&lt;br&gt;[.NET 8, REST]&lt;br&gt;каталог депозитов и ставок, заявки, СМС-код подтверждения, статусы" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2d9c5a;strokeColor=#1f7a45;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="955" y="250" width="300" height="120" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;БД сервиса депозитов&lt;/b&gt;&lt;br&gt;[MS SQL, Always On]" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#2d9c5a;strokeColor=#1f7a45;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="955" y="420" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;Сервис уведомлений&lt;/b&gt;&lt;br&gt;[.NET 8]&lt;br&gt;формирует и отправляет СМС через шлюз, ведёт журнал отправок" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2d9c5a;strokeColor=#1f7a45;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="955" y="560" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;[кластер в двух ЦОД]&lt;br&gt;топики:&lt;br&gt;deposit.application&lt;br&gt;deposit.rates&lt;br&gt;deposit.status&lt;br&gt;sms.requested" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2d9c5a;strokeColor=#1f7a45;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1330" y="225" width="145" height="440" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;Интеграционный адаптер АБС&lt;/b&gt;&lt;br&gt;[Java Spring Boot]&lt;br&gt;читает заявки из Kafka и передаёт в АБС с ограничением скорости; публикует ставки и статусы из таблицы событий" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2d9c5a;strokeColor=#1f7a45;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1565" y="255" width="430" height="115" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;БД АБС&lt;/b&gt;&lt;br&gt;[Oracle, PL/SQL]&lt;br&gt;новое: модуль ставок и заявок на депозит, таблица исходящих событий, ролевая модель депозиты / кредиты" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2e6295;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1565" y="430" width="430" height="150" as="geometry"/></mxCell>
<mxCell id="c23" value="&lt;b&gt;Десктоп-клиент АБС&lt;/b&gt;&lt;br&gt;[Delphi]&lt;br&gt;новое: экраны ставок, заявок и согласования особых ставок" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2e6295;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1565" y="650" width="430" height="100" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;b&gt;СМС-шлюз&lt;/b&gt;&lt;br&gt;[поддерживает IT-отдел банка]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#666666;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="955" y="730" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;b&gt;Телеком-оператор&lt;/b&gt;&lt;br&gt;[External System]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="730" width="215" height="80" as="geometry"/></mxCell>
