<mxCell id="c2" value="C4. Диаграмма контекста: открытие депозитов онлайн (MVP)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=15;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1500" height="28" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;новый или существующий клиент банка" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073b6f;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="360" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;Менеджер кол-центра&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;звонит по заявкам с сайта" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073b6f;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Менеджер бэк-офиса депозитов&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;обрабатывает заявки, ведёт ставки" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073b6f;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="90" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Сотрудник отдела кредитования&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;согласует особые ставки" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073b6f;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1330" y="360" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;Сайт банка&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;новое: список депозитов со ставками и форма заявки" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2e6295;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Интернет-банк&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;новое: депозиты, персональные ставки, заявка с подтверждением по СМС" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2e6295;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="280" height="120" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;новое: ставки и согласование в системе, приём заявок от интернет-банка" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2e6295;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="360" width="280" height="120" as="geometry"/></mxCell>
