<mxCell id="c6" value="&lt;b&gt;Потребитель ставок&lt;/b&gt;&lt;br&gt;[Kafka consumer]&lt;br&gt;читает deposit.rates, обновляет каталог" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#666666;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="230" height="100" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;Каталог ставок&lt;/b&gt;&lt;br&gt;[MS SQL]&lt;br&gt;актуальные общие ставки и номер версии набора" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#666666;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="290" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;API ставок&lt;/b&gt;&lt;br&gt;[REST, только чтение]&lt;br&gt;общие ставки для кол-центра банка" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2d9c5a;strokeColor=#1f7a45;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="230" height="100" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Планировщик выгрузки&lt;/b&gt;&lt;br&gt;[scheduler]&lt;br&gt;каждый день в 08:00 и при смене версии ставок" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2d9c5a;strokeColor=#1f7a45;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Формирователь файла&lt;/b&gt;&lt;br&gt;[CSV UTF-8 + SHA-256]&lt;br&gt;только общие ставки, без персональных данных" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2d9c5a;strokeColor=#1f7a45;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="240" height="110" as="geometry"/></mxCell>
